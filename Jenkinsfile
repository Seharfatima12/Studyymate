                echo 'Getting code from GitHub'
            }
        }

        stage('Build') {
            steps {
                echo 'Building StudyMate'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing StudyMate'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying the project'
            }
        }

    }
}
